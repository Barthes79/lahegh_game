# توکن ربات تلگرام (از BotFather)
BOT_TOKEN=123456:ABC-your-token-here

# مسیر فایل دیتابیس SQLite
DATABASE_PATH=laahiq.db

# آیدی‌های عددی ادمین‌ها (اختیاری، جدا شده با کاما) — برای دستورات مدیریتی آینده
ADMIN_IDS=

# فاصله زمانی بین یادآوری‌های غیرفعالی برای یک کاربر (ساعت) — یادآور بعدی زودتر از این فاصله ارسال نمی‌شود
REMINDER_MIN_GAP_HOURS=24

# بعد از چند ساعت بی‌فعالیتی یادآوری ارسال شود
REMINDER_INACTIVITY_HOURS=12

# هر چند دقیقه یک‌بار سیستم بررسی کند کدام کاربران باید یادآوری بگیرند
REMINDER_CHECK_INTERVAL_MINUTES=30

# --- مسیر انتظار: اوقات شرعی (Aladhan API) ---
# پیش‌فرض: تهران، روش ۷ (مؤسسه ژئوفیزیک دانشگاه تهران). برای شهر دیگر مختصات را عوض کنید.
PRAYER_LATITUDE=35.6892
PRAYER_LONGITUDE=51.3890
PRAYER_METHOD=7
PRAYER_TIMEZONE=Asia/Tehran

# --- لینک پست صوتی درس ۱ در کانال عمومی (روی پست: Copy Post Link) ---
# خالی بگذاری، فایل صوتی مثل قبل جدا فرستاده می‌شود.
LESSON_1_AUDIO_URL=https://t.me/YourChannel/123
# لینک پست صوتی درس ۲ (شرط رفتن از سطح ۲ به ۳)
LESSON_2_AUDIO_URL=https://t.me/dsfgnsdfhre/4
